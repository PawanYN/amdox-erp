# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amdox_erp?schema=public"

# Server Port Settings
PORT=3001
NODE_ENV=development

# Frontend API URL (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001

# CORS allowlist — comma-separated list of frontend origins allowed to call the API
FRONTEND_URL=http://localhost:3000

# Authentication Secrets
JWT_SECRET="change-this-to-a-secure-random-key-in-your-real-env"

# OCR — Invoice extraction (F-03, target >= 95% accuracy)
# textract = AWS Textract (requires: pnpm add @aws-sdk/client-textract --filter api)
OCR_PROVIDER=mock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ML demand forecasting service (F-06)
ML_SERVICE_URL=http://localhost:8091

# Bull Board (queue retry/dead-letter dashboard at /admin/queues) — change in production
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=change-this-to-a-secure-random-password
