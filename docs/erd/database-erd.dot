  }
  subgraph cluster_3 {
    label="Supply Chain & Inventory"; fontsize=17; style="rounded,filled"; fillcolor="#B36B0014"; color="#B36B00"; penwidth=2; fontcolor="#B36B00";
    Vendor [fillcolor="#B36B00", fontcolor="white"];
