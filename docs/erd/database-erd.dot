  subgraph cluster_9 {
    label="Eventing & Sagas"; fontsize=17; style="rounded,filled"; fillcolor="#4B556314"; color="#4B5563"; penwidth=2; fontcolor="#4B5563";
    OutboxEvent [fillcolor="#4B5563", fontcolor="white"];
    SagaState [fillcolor="#4B5563", fontcolor="white"];
  }
  UserRole -> User;
  UserRole -> Role;
