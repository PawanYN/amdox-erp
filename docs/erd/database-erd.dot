    ExchangeRate [fillcolor="#1A7A3C", fontcolor="white"];
    IntercompanyTransfer [fillcolor="#1A7A3C", fontcolor="white"];
    Customer [fillcolor="#1A7A3C", fontcolor="white"];
    SalesOrder [fillcolor="#1A7A3C", fontcolor="white"];
    SalesOrderLine [fillcolor="#1A7A3C", fontcolor="white"];
    Invoice [fillcolor="#1A7A3C", fontcolor="white"];
    InvoiceLine [fillcolor="#1A7A3C", fontcolor="white"];
    Payment [fillcolor="#1A7A3C", fontcolor="white"];
    PaymentRun [fillcolor="#1A7A3C", fontcolor="white"];
  }
  subgraph cluster_2 {
    label="HR & Payroll"; fontsize=17; style="rounded,filled"; fillcolor="#B3125F14"; color="#B3125F"; penwidth=2; fontcolor="#B3125F";
    Department [fillcolor="#B3125F", fontcolor="white"];
    Employee [fillcolor="#B3125F", fontcolor="white"];
