  subgraph cluster_4 {
    label="AI Forecasting"; fontsize=17; style="rounded,filled"; fillcolor="#0E749014"; color="#0E7490"; penwidth=2; fontcolor="#0E7490";
    ForecastModel [fillcolor="#0E7490", fontcolor="white"];
    ForecastPrediction [fillcolor="#0E7490", fontcolor="white"];
  }
  subgraph cluster_5 {
    label="Project Management"; fontsize=17; style="rounded,filled"; fillcolor="#1F6FB214"; color="#1F6FB2"; penwidth=2; fontcolor="#1F6FB2";
